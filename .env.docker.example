# ============================================================
# Micracode — Docker Compose environment file
# Copy this file to .env.docker and fill in your API key.
#
# This file is loaded automatically by docker-compose.yml.
# Do NOT commit a filled-in copy to source control.
# ============================================================

# ---------- Shared ----------
APP_WEB_ORIGIN=http://localhost:3000

# ---------- Next.js (apps/web) ----------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---------- FastAPI (apps/api) ----------
# LLM provider: `gemini` (default), `openai`, or `ollama`.
LLM_PROVIDER=gemini

# Gemini (used when LLM_PROVIDER=gemini)
GOOGLE_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# OpenAI (used when LLM_PROVIDER=openai)
# OPENAI_API_KEY=replace-with-your-openai-api-key
# OPENAI_MODEL=gpt-5.4

# Ollama (used when LLM_PROVIDER=ollama — no API key required)
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=llama3.2

# Logging
LOG_LEVEL=INFO
